	value: float;
}

enum SerialDeviceType: uint8 {
	ESP_TRACKER = 0,
	HID_RECEIVER = 1,
	HID_TRACKER = 2,
}

table SerialDevice {
	port: string;
	name: string;
	type: SerialDeviceType;
}

table OpenSerialRequest {
	auto: bool;
	port: string;
}

table CloseSerialRequest {}
table SetWifiRequest (deprecated) {
	ssid: string;
	password: string;
}
