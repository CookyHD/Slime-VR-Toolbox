; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SlimeVR-Toolbox"
run/main_scene="uid://bk6t8yil4exld"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0.1, 0.1, 0.1, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://b4ncnuv536xur"
config/icon="uid://luubuaio2t3n"

[autoload]

Math="*uid://dl4301o2amu6g"
Utils="*uid://dio15nc2vlkdl"
Global="*uid://dlarkv2kuk6r7"
Discord="*uid://b2e25i5sguu56"
OTAUpdater="*uid://cldsde4520fst"
SlimeVRServer="*uid://c54u2sl8niuts"
HapticServer="*uid://bvsq1hxb2qk22"

[display]

window/size/viewport_width=1280
window/size/viewport_height=750
window/size/borderless=true
window/subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray("res://addons/plugin/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://assets/": "orange",
"res://resources/": "yellow",
"res://src/": "purple",
"res://src/scenes/": "blue",
"res://src/schema/": "gray",
"res://src/shaders/": "gray"
}

[flatbuffers]

EditorLog/=true
Colours/Syntax/unknown=Color(0.8, 0.8068627, 0.8411765, 1)
Colours/Syntax/comment=Color(0.8, 0.8068627, 0.8411765, 0.5)
Colours/Syntax/comment_doc=Color(0.6, 0.7, 0.8, 0.8)
Colours/Syntax/keyword=Color(1, 0.44, 0.52, 1)
Colours/Syntax/type=Color(0.26, 1, 0.76, 1)
Colours/Syntax/string=Color(1, 0.93, 0.63, 1)
Colours/Syntax/punct=Color(0.8, 0.8068627, 0.8411765, 1)
Colours/Syntax/ident=Color(0.67, 0.79, 1, 1)
Colours/Syntax/scalar=Color(0.63, 1, 0.88, 1)
Colours/Syntax/meta=Color(0.8, 0.8068627, 0.8411765, 1)
Colours/Notice/critical=Color(0.77, 0.35, 0.35, 1)
Colours/Notice/error=Color(0.77, 0.35, 0.35, 1)
Colours/Notice/warning=Color(0.72, 0.61, 0.48, 1)
Colours/Notice/notice=Color(0.56, 0.67, 0.51, 1)
Colours/Notice/debug=Color(0.6, 0.7, 0.8, 0.8)
Colours/Notice/trace=Color(0.8, 0.8068627, 0.8411765, 0.5)
debug=false
experimental=false
EditorLog/verbosity=0
highlight_error=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
